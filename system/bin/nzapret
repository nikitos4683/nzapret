#!/system/bin/sh
# nzapret — CLI management utility
# Installed to /system/bin/ via Magisk overlay.
# Controls nfqws2 and nztg, hostlists, profiles, Private DNS, the Telegram
# proxy and diagnostics, with JSON output for the WebUI.

MODDIR="/data/adb/modules/nzapret"
LIST_COUNT_CACHE="$MODDIR/.list_count"
DIAGNOSE_COMMANDS="iptables pgrep tail curl ip settings"
DEFAULT_LIST_SOURCE="https://raw.githubusercontent.com/bol-van/rulist/refs/heads/main/reestr_hostname.txt"

# Shared constants and helpers (logging, firewall, profiles, Private DNS).
. "$MODDIR/common.sh"

# --- Helpers ---
die() {
    echo "$*"
    exit 1
}

require_cmd() {
    has_cmd "$1" || die "[-] Missing command: $1"
}

ensure_runtime_layout() {
    mkdir -p "$PROFILE_DIR" "$LISTS" >/dev/null 2>&1
    [ -f "$USER_LIST_FILE" ] || : > "$USER_LIST_FILE" 2>/dev/null
}

make_temp_file() {
    _tmp=$(mktemp 2>/dev/null)
    if [ -z "$_tmp" ]; then
        _tmp="/data/local/tmp/nzapret.$$.tmp"
        : > "$_tmp" 2>/dev/null || return 1
    fi
    echo "$_tmp"
}

get_version() {
    grep '^version=' "$MODDIR/module.prop" 2>/dev/null | cut -d= -f2 | tr -d '\r\n'
}

# parse_switch <value>: prints 1/0 for on/off style values.
parse_switch() {
    case "$1" in
        on|1|true|enabled) echo 1 ;;
        off|0|false|disabled) echo 0 ;;
        *) return 1 ;;
    esac
}

# --- JSON ---
json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# bool <command...>: prints true/false for the command's exit status.
bool() {
    if "$@"; then echo true; else echo false; fi
}

# --- Processes ---
is_live_pid() {
    [ -d "/proc/$1" ] || return 1
    [ "$(awk '/^State:/ { print $2; exit }' "/proc/$1/status" 2>/dev/null)" != "Z" ]
}

# list_live_pids <name>: non-zombie PIDs of a process name.
list_live_pids() {
    for _pid in $(pgrep -x "$1" 2>/dev/null); do
        if is_live_pid "$_pid"; then
            echo "$_pid"
        fi
    done
}

# Sets PID/PID_COUNT for nfqws2 and TG_PID/TG_PID_COUNT for nztg.
load_process_state() {
    set -- $(list_live_pids "$PROCESS_NAME")
    PID="${1:-}"
    PID_COUNT=$#
    set -- $(list_live_pids "$TG_PROCESS_NAME")
    TG_PID="${1:-}"
    TG_PID_COUNT=$#
}

is_running() {
    [ -n "$(list_live_pids "$PROCESS_NAME")" ]
}

# wait_for_exit <name> [tries]: poll in 100 ms steps until the process is gone.
wait_for_exit() {
    _tries="${2:-15}"
    while [ -n "$(list_live_pids "$1")" ]; do
        [ "$_tries" -gt 0 ] || return 1
        sleep 0.1 2>/dev/null || sleep 1
        _tries=$((_tries - 1))
    done
}

# print_process_line <name> <pid> <count>
print_process_line() {
    if [ -n "$2" ]; then
        echo "$1: [ON] (PID: $2)"
        [ "$3" -gt 1 ] && echo "warning: multiple $1 processes detected ($3)"
    else
        echo "$1: [OFF]"
    fi
    return 0
}

# --- Firewall ---
# The IPv6 firewall is up whenever ip6tables can manage mangle rules (mirrors
# resolve_firewall_stack in service.sh). There is no mode to configure: idle
# IPv6 rules are free and already protect IPv6 that appears after boot or a
# network switch. The probe result is memoized in IPV6_FW.
ipv6_firewall_enabled() {
    if [ -z "$IPV6_FW" ]; then
        if ip6tables_supported; then IPV6_FW=1; else IPV6_FW=0; fi
    fi
    [ "$IPV6_FW" = "1" ]
}

firewall_stack_label() {
    if ipv6_firewall_enabled; then
        echo "IPv4 + IPv6"
    else
        echo "IPv4 only (ip6tables unavailable)"
    fi
}

get_rule_count() {
    "$1" -w -t mangle -L "$CHAIN" -n 2>/dev/null | grep -c NFQUEUE
}

has_jump_rules() {
    for _jt in iptables ip6tables; do
        for _jh in OUTPUT FORWARD; do
            check_jump_rule "$_jt" "$_jh" && return 0
        done
    done
    return 1
}

# --- Private DNS ---
# Sets PDNS_MODE, PDNS_HOST and PDNS_CODE (unavailable | off | auto |
# hostname_default | hostname_custom | hostname_unspecified) with a single
# round of `settings` reads.
load_private_dns_state() {
    PDNS_MODE=$(get_private_dns_mode)
    PDNS_HOST=$(get_private_dns_hostname)
    if ! has_cmd settings; then
        PDNS_CODE="unavailable"
        return
    fi
    case "$PDNS_MODE" in
        "off") PDNS_CODE="off" ;;
        "hostname")
            if [ -z "$PDNS_HOST" ]; then
                PDNS_CODE="hostname_unspecified"
            elif [ "$PDNS_HOST" = "$DEFAULT_PRIVATE_DNS_HOSTNAME" ]; then
                PDNS_CODE="hostname_default"
            else
                PDNS_CODE="hostname_custom"
            fi
            ;;
        *) PDNS_CODE="auto" ;;
    esac
}

private_dns_mode_label() {
    case "$1" in
        "off") echo "Off" ;;
        "hostname") echo "Provider hostname" ;;
        *) echo "Automatic" ;;
    esac
}

# Short label (status JSON): the provider hostname itself when one is set.
private_dns_label() {
    case "$PDNS_CODE" in
        unavailable) echo "Unavailable" ;;
        hostname_default|hostname_custom) echo "$PDNS_HOST" ;;
        *) private_dns_mode_label "$PDNS_MODE" ;;
    esac
}

# Human-readable summary (status / diagnose).
private_dns_summary() {
    case "$PDNS_CODE" in
        unavailable) echo "Unavailable (settings command missing)" ;;
        hostname_default|hostname_custom) echo "Provider hostname ($PDNS_HOST)" ;;
        *) private_dns_mode_label "$PDNS_MODE" ;;
    esac
}

# set_private_dns <off|auto|hostname> [host]: apply and mark initialized, so
# later service starts never overwrite a manual choice.
set_private_dns() {
    has_cmd settings || return 1
    case "$1" in
        off) put_global_setting private_dns_mode off ;;
        auto) put_global_setting private_dns_mode opportunistic ;;
        hostname) apply_private_dns_hostname "$2" ;;
        *) return 1 ;;
    esac || return 1
    mark_private_dns_initialized
}

print_private_dns_status() {
    load_private_dns_state
    if [ "$PDNS_CODE" = "unavailable" ]; then
        echo "Private DNS: unavailable (settings command missing)"
        return 0
    fi

    echo "Configured mode: $(private_dns_mode_label "$PDNS_MODE")"
    [ "$PDNS_MODE" = "hostname" ] && echo "Provider hostname: ${PDNS_HOST:-(empty)}"
    if [ -f "$PRIVATE_DNS_INIT_FILE" ]; then
        echo "Module default: initialized"
    else
        echo "Module default: pending first nzapret start ($DEFAULT_PRIVATE_DNS_HOSTNAME)"
    fi
}

dns_usage() {
    echo "Usage: nzapret dns status"
    echo "       nzapret dns set <off|auto|default>"
    echo "       nzapret dns set hostname <fqdn>"
    exit 1
}

# --- Profiles ---
profile_uses_user_list() {
    grep -F -q -e "$USER_LIST_FILE" "$(profile_config_file "$1")" 2>/dev/null
}

active_profile_uses_user_list() {
    profile_uses_user_list "$(get_active_profile)"
}

set_active_profile() {
    [ -f "$(profile_config_file "$1")" ] || die "[-] Unknown profile: $1"
    mkdir -p "$PROFILE_DIR" >/dev/null 2>&1
    printf '%s\n' "$1" > "$ACTIVE_PROFILE_FILE"
}

list_profiles() {
    _found=0
    for _pconfig in "$PROFILE_DIR"/*.conf; do
        [ -f "$_pconfig" ] || continue
        _pname=$(basename "$_pconfig" .conf)
        printf '%s\t%s\n' "$_pname" "$(get_profile_label "$_pname")"
        _found=1
    done
    [ "$_found" = "1" ] || echo "(no profiles found)"
}

# --- Hostlists ---
# Line count of the (large) general hostlist, cached in .list_count.
# Pass 1 to recount and refresh the cache.
general_list_count() {
    if [ "$1" != "1" ] && [ -f "$LIST_COUNT_CACHE" ]; then
        cat "$LIST_COUNT_CACHE"
        return
    fi
    _count=0
    [ -f "$GENERAL_LIST_FILE" ] && _count=$(wc -l < "$GENERAL_LIST_FILE")
    echo "$_count" > "$LIST_COUNT_CACHE" 2>/dev/null
    echo "$_count"
}

# domain_count <file>: entries excluding blank and comment lines.
domain_count() {
    if [ -f "$1" ]; then
        grep -c -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$1"
    else
        echo 0
    fi
}

# add_list_entries <file> <entries...>: append trimmed, non-comment entries not
# yet present in <file>; prints how many were added.
add_list_entries() {
    _af="$1"; shift
    _added=0
    for _entry in "$@"; do
        _clean=$(trim_value "$_entry")
        case "$_clean" in
            ""|\#*) continue ;;
        esac
        grep -F -x -q -e "$_clean" "$_af" 2>/dev/null && continue
        printf '%s\n' "$_clean" >> "$_af" || return 1
        _added=$((_added + 1))
    done
    echo "$_added"
}

# update_user_list <append|replace> <entries...>: rewrite list-user.txt through
# a temp file; prints how many entries were added.
update_user_list() {
    _mode="$1"; shift
    _tmp=$(make_temp_file) || return 1
    if [ "$_mode" = "append" ] && [ -f "$USER_LIST_FILE" ]; then
        # Re-emit line by line so a missing final newline cannot glue entries.
        while IFS= read -r _line || [ -n "$_line" ]; do
            printf '%s\n' "$_line"
        done < "$USER_LIST_FILE" > "$_tmp"
    else
        : > "$_tmp"
    fi || { rm -f "$_tmp"; return 1; }

    _added=$(add_list_entries "$_tmp" "$@") && mv -f "$_tmp" "$USER_LIST_FILE" \
        || { rm -f "$_tmp"; return 1; }
    echo "$_added"
}

remove_user_list_entries() {
    [ -f "$USER_LIST_FILE" ] || return 0
    _pat=$(make_temp_file) || return 1
    for _entry in "$@"; do
        _clean=$(trim_value "$_entry")
        case "$_clean" in
            ""|\#*) continue ;;
        esac
        printf '%s\n' "$_clean"
    done > "$_pat"
    [ -s "$_pat" ] || { rm -f "$_pat"; return 0; }

    _tmp=$(make_temp_file) || { rm -f "$_pat"; return 1; }
    # grep exits 1 when every line got removed; only >1 is a real error.
    grep -v -F -x -f "$_pat" "$USER_LIST_FILE" > "$_tmp"
    [ $? -le 1 ] && mv -f "$_tmp" "$USER_LIST_FILE"
    _rc=$?
    rm -f "$_tmp" "$_pat"
    return $_rc
}

print_user_list_status() {
    _user_count=$(domain_count "$USER_LIST_FILE")
    if active_profile_uses_user_list; then
        echo "list-user.txt: $_user_count domains (included by current configuration)"
    else
        echo "list-user.txt: $_user_count domains (current configuration does not reference it)"
    fi
    echo ""
    echo "Domains:"
    if [ "$_user_count" -gt 0 ]; then
        grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$USER_LIST_FILE"
    else
        echo "(empty)"
    fi
}

# Download the general hostlist; an empty or failed download keeps the old list.
update_general_list() {
    _tmp=$(make_temp_file) || {
        echo "[-] Failed to create temporary file for list-general.txt"
        return 1
    }
    curl -s -f -L -o "$_tmp" "$DEFAULT_LIST_SOURCE" 2>/dev/null
    if [ -s "$_tmp" ] && mv -f "$_tmp" "$GENERAL_LIST_FILE"; then
        echo "[+] list-general.txt updated"
        return 0
    fi
    rm -f "$_tmp"
    echo "[-] Failed to download list-general.txt"
    return 1
}

# nfqws2 rereads hostlists on change; SIGHUP makes it immediate.
refresh_hostlists_if_running() {
    _pids=$(list_live_pids "$PROCESS_NAME")
    if [ -z "$_pids" ]; then
        echo "[*] nzapret is not running. Changes will apply on next start."
        return 0
    fi
    _reloaded=0
    for _pid in $_pids; do
        kill -HUP "$_pid" 2>/dev/null && _reloaded=1
    done
    if [ "$_reloaded" = "1" ]; then
        echo "[*] Sent SIGHUP to nfqws2 to refresh hostlists."
    else
        echo "[*] nfqws2 is running. Hostlists reload automatically after file changes."
    fi
}

# --- Status ---
print_list_line() {
    if [ -f "$2" ]; then
        echo "$1: $3 domains"
    else
        echo "$1: MISSING"
    fi
}

print_status_human() {
    load_process_state
    load_private_dns_state
    _ver=$(get_version)

    [ -n "$_ver" ] && echo "Module version: $_ver"
    print_process_line "$PROCESS_NAME" "$PID" "$PID_COUNT"
    print_process_line "$TG_PROCESS_NAME" "$TG_PID" "$TG_PID_COUNT"
    echo "iptables rules: $(get_rule_count iptables) (IPv4), $(get_rule_count ip6tables) (IPv6)"
    echo "Firewall stack: $(firewall_stack_label)"
    echo "Private DNS: $(private_dns_summary)"
    echo ""

    print_list_line list-general.txt "$GENERAL_LIST_FILE" "$(general_list_count)"
    print_list_line list-google.txt "$GOOGLE_LIST_FILE" "$(domain_count "$GOOGLE_LIST_FILE")"
    echo "list-user.txt: $(domain_count "$USER_LIST_FILE") domains"
    if active_profile_uses_user_list; then
        echo "list-user binding: included by current configuration"
    else
        echo "list-user binding: inactive (current configuration missing --hostlist=$USER_LIST_FILE)"
    fi
}

print_status_json() {
    load_process_state
    load_private_dns_state
    _prof=$(get_active_profile)

    printf '{"version":"%s","active":%s,"pid":"%s","pid_count":%s,"rules_v4":%s,"rules_v6":%s,"domain_count":%s,"google_domain_count":%s,"user_domain_count":%s,"user_list_attached":%s,"profile":"%s","profile_label":"%s","private_dns_available":%s,"private_dns_initialized":%s,"private_dns_mode":"%s","private_dns_mode_label":"%s","private_dns_hostname":"%s","private_dns_label":"%s","private_dns_default_hostname":"%s","tg_active":%s,"tg_pid":"%s","tg_port":"%s","tg_cf_enabled":%s}\n' \
        "$(json_escape "$(get_version)")" \
        "$(bool [ -n "$PID" ])" \
        "$PID" \
        "$PID_COUNT" \
        "$(get_rule_count iptables)" \
        "$(get_rule_count ip6tables)" \
        "$(general_list_count)" \
        "$(domain_count "$GOOGLE_LIST_FILE")" \
        "$(domain_count "$USER_LIST_FILE")" \
        "$(bool profile_uses_user_list "$_prof")" \
        "$(json_escape "$_prof")" \
        "$(json_escape "$(get_profile_label "$_prof")")" \
        "$(bool [ "$PDNS_CODE" != "unavailable" ])" \
        "$(bool [ -f "$PRIVATE_DNS_INIT_FILE" ])" \
        "$(json_escape "$PDNS_MODE")" \
        "$(json_escape "$(private_dns_mode_label "$PDNS_MODE")")" \
        "$(json_escape "$PDNS_HOST")" \
        "$(json_escape "$(private_dns_label)")" \
        "$(json_escape "$DEFAULT_PRIVATE_DNS_HOSTNAME")" \
        "$(bool [ -n "$TG_PID" ])" \
        "$TG_PID" \
        "$(json_escape "$(get_tg_conf port "$DEFAULT_TG_PORT")")" \
        "$(bool [ "$(get_tg_conf cf_enabled 1)" != "0" ])"
}

# --- Service control ---
start_service() {
    "$MODDIR/service.sh" manual && is_running
}

# report_started <verb>
report_started() {
    load_process_state
    echo "[+] nfqws2 $1 successfully (PID: $PID)"
    [ -n "$TG_PID" ] && echo "[+] nztg $1 successfully (PID: $TG_PID)"
    return 0
}

# Stop both daemons and tear down the firewall, escalating to SIGKILL.
stop_service() {
    "$MODDIR/uninstall.sh" >/dev/null 2>&1

    wait_for_exit "$TG_PROCESS_NAME" || killall -9 "$TG_PROCESS_NAME" 2>/dev/null
    if ! wait_for_exit "$PROCESS_NAME"; then
        killall -9 "$PROCESS_NAME" 2>/dev/null
        wait_for_exit "$PROCESS_NAME" 3 || return 1
    fi

    # uninstall.sh already tore the chains down; retry once if a jump survived.
    has_jump_rules && cleanup_tables
    ! has_jump_rules
}

# --- Telegram proxy (nztgproxy) ---
# Generate a new MTProto secret, store it, and print it.
write_tg_secret() {
    [ -f "$NZTG_BIN" ] || return 1
    _sec=$("$NZTG_BIN" gensecret 2>/dev/null) || return 1
    [ -n "$_sec" ] || return 1
    printf '%s\n' "$_sec" > "$TG_SECRET_FILE" || return 1
    chmod 600 "$TG_SECRET_FILE" 2>/dev/null
    echo "$_sec"
}

get_tg_secret() {
    if [ -s "$TG_SECRET_FILE" ]; then
        head -n 1 "$TG_SECRET_FILE" 2>/dev/null | tr -d '\r\n'
    else
        write_tg_secret
    fi
}

get_tg_link() {
    _tgs=$(get_tg_secret) || return 1
    printf 'tg://proxy?server=%s&port=%s&secret=dd%s' \
        "$(get_tg_conf host "$DEFAULT_TG_HOST")" "$(get_tg_conf port "$DEFAULT_TG_PORT")" "$_tgs"
}

# Validate a multi-line DC->IP ruleset (one "n:IP" per line). Prints cleaned
# rules on success; returns 1 on any invalid line.
validate_tg_dc_rules() {
    while IFS= read -r _line || [ -n "$_line" ]; do
        _line=$(trim_value "$_line")
        case "$_line" in
            ""|\#*) continue ;;
        esac
        case "${_line%%:*}" in
            ''|*[!0-9]*) return 1 ;;
        esac
        case "${_line#*:}" in
            ''|*[!0-9.]*) return 1 ;;
        esac
        printf '%s\n' "$_line"
    done
}

# tg_conf_set <key> [value...]: replace every `key=` line with one per value.
tg_conf_set() {
    _key="$1"; shift
    ensure_tgproxy_conf
    _tmp=$(make_temp_file) || return 1
    grep -v "^$_key=" "$TGPROXY_CONF" > "$_tmp" 2>/dev/null
    for _v in "$@"; do
        printf '%s=%s\n' "$_key" "$_v"
    done >> "$_tmp"
    mv -f "$_tmp" "$TGPROXY_CONF"
}

print_tg_status() {
    ensure_tgproxy_conf
    load_process_state
    if [ -n "$TG_PID" ]; then
        echo "nztgproxy: [ON] (PID: $TG_PID)"
    else
        echo "nztgproxy: [OFF]"
    fi
    echo "Host: $(get_tg_conf host "$DEFAULT_TG_HOST")"
    echo "Port: $(get_tg_conf port "$DEFAULT_TG_PORT")"
    echo "Secret: $(get_tg_secret)"
    echo "Link: $(get_tg_link)"
    if [ "$(get_tg_conf cf_enabled 1)" = "0" ]; then
        echo "Cloudflare proxy: disabled"
    else
        _cfd=$(get_tg_conf cf_domain "")
        if [ -n "$_cfd" ]; then
            echo "Cloudflare proxy: enabled (custom: $_cfd)"
        else
            echo "Cloudflare proxy: enabled (auto domains)"
        fi
    fi
    if [ "$(get_tg_conf preresolve_enabled 1)" = "0" ]; then
        echo "DC pre-resolve: disabled"
    else
        echo "DC pre-resolve: enabled"
    fi
    echo "Datacenters:"
    for _d in $(get_tg_dc_lines); do
        echo "  $_d"
    done
}

print_tg_status_json() {
    ensure_tgproxy_conf
    load_process_state
    _dcs=""
    for _d in $(get_tg_dc_lines); do
        _dcs="${_dcs:+$_dcs,}\"$(json_escape "$_d")\""
    done
    printf '{"host":"%s","port":"%s","secret":"%s","link":"%s","dc_redirects":[%s],"cf_enabled":%s,"cf_domain":"%s","preresolve_enabled":%s,"active":%s,"pid":"%s"}\n' \
        "$(json_escape "$(get_tg_conf host "$DEFAULT_TG_HOST")")" \
        "$(json_escape "$(get_tg_conf port "$DEFAULT_TG_PORT")")" \
        "$(json_escape "$(get_tg_secret)")" \
        "$(json_escape "$(get_tg_link)")" \
        "$_dcs" \
        "$(bool [ "$(get_tg_conf cf_enabled 1)" != "0" ])" \
        "$(json_escape "$(get_tg_conf cf_domain "")")" \
        "$(bool [ "$(get_tg_conf preresolve_enabled 1)" != "0" ])" \
        "$(bool [ -n "$TG_PID" ])" \
        "$TG_PID"
}

# --- Diagnostics ---
# diag <ok|fail> <human text> <json name> <json detail> <code> <detail_code> [key=value...]
# Prints one check as a human-readable line, or appends it to DIAG_CHECKS when
# DIAG_JSON=1. Empty key=value extras are omitted from the JSON object.
diag() {
    _st="$1"; _human="$2"; _name="$3"; _detail="$4"; _code="$5"; _dcode="$6"
    shift 6
    if [ "$DIAG_JSON" != "1" ]; then
        if [ "$_st" = "ok" ]; then echo "[OK] $_human"; else echo "[!!] $_human"; fi
        return 0
    fi

    _obj="{\"name\":\"$(json_escape "$_name")\",\"status\":\"$_st\",\"detail\":\"$(json_escape "$_detail")\",\"code\":\"$_code\",\"detail_code\":\"$_dcode\""
    for _kv in "$@"; do
        [ -n "${_kv#*=}" ] && _obj="$_obj,\"${_kv%%=*}\":\"$(json_escape "${_kv#*=}")\""
    done
    DIAG_CHECKS="${DIAG_CHECKS:+$DIAG_CHECKS,}$_obj}"
    if [ "$_st" = "ok" ]; then
        DIAG_OK=$((DIAG_OK + 1))
    else
        DIAG_FAIL=$((DIAG_FAIL + 1))
    fi
}

diag_process() {
    if [ -n "$2" ]; then
        diag ok "$1 running (PID: $2)" "$1 process" "running (pid: $2)" process running "subject=$1" "pid=$2"
    else
        diag fail "$1 is not running" "$1 process" "not running" process not_running "subject=$1"
    fi
}

# diag_jump <table> <family> <hook>
diag_jump() {
    if check_jump_rule "$1" "$3"; then
        diag ok "$1 $3 jump present" "$1 $3" "jump present" jump_rule present "subject=$1" "table=$1" "hook=$3" "family=$2"
    else
        diag fail "$1 $3 jump missing" "$1 $3" "jump missing" jump_rule missing "subject=$1" "table=$1" "hook=$3" "family=$2"
    fi
}

# run_diagnose [1]: human-readable checklist, or JSON when called with 1.
run_diagnose() {
    DIAG_JSON="$1"
    DIAG_CHECKS=""
    DIAG_OK=0
    DIAG_FAIL=0
    if [ "$DIAG_JSON" != "1" ]; then
        echo "nzapret diagnostics"
        echo "--------------------"
    fi

    for _cmd in $DIAGNOSE_COMMANDS; do
        if has_cmd "$_cmd"; then
            diag ok "command available: $_cmd" "$_cmd" "command available" command available "subject=$_cmd"
        else
            diag fail "missing command: $_cmd" "$_cmd" "command missing" command missing "subject=$_cmd"
        fi
    done

    if ! has_cmd ip6tables; then
        diag ok "ip6tables missing, IPv4-only firewall" ip6tables "missing, IPv4-only firewall" ip6tables_runtime missing_fallback subject=ip6tables family=ipv6
    elif ipv6_firewall_enabled; then
        diag ok "command available: ip6tables" ip6tables "command available" ip6tables_runtime available subject=ip6tables family=ipv6
    else
        diag fail "ip6tables present but unusable" ip6tables "present but unusable" ip6tables_runtime unusable subject=ip6tables family=ipv6
    fi

    for _file in "$(profile_config_file "$(get_active_profile)")" "$USER_LIST_FILE" $(list_required_files); do
        _fname=${_file##*/}
        if [ -f "$_file" ]; then
            diag ok "file present: $_file" "$_fname" "file present" runtime_file present "subject=$_fname"
        else
            diag fail "missing file: $_file" "$_fname" "file missing" runtime_file missing "subject=$_fname"
        fi
    done

    load_process_state
    diag_process "$PROCESS_NAME" "$PID"
    diag_process "$TG_PROCESS_NAME" "$TG_PID"

    if active_profile_uses_user_list; then
        diag ok "current configuration includes list-user.txt" "list-user binding" "current configuration includes list-user.txt" userlist_binding attached subject=list-user.txt
    else
        diag fail "current configuration does not reference list-user.txt" "list-user binding" "current configuration does not reference list-user.txt" userlist_binding detached subject=list-user.txt
    fi

    _stack=$(firewall_stack_label)
    if ipv6_firewall_enabled; then _stack_code=dual_stack; else _stack_code=ipv4_only; fi
    diag ok "Firewall stack: $_stack" "firewall stack" "$_stack" ip_stack "$_stack_code" family=ipv6

    load_private_dns_state
    if [ "$PDNS_CODE" = "unavailable" ]; then
        diag fail "Private DNS unavailable: settings command missing" "private dns" "settings command missing" private_dns unavailable "default_hostname=$DEFAULT_PRIVATE_DNS_HOSTNAME"
    else
        _pdns=$(private_dns_summary)
        diag ok "Private DNS: $_pdns" "private dns" "$_pdns" private_dns "$PDNS_CODE" "hostname=$PDNS_HOST" "default_hostname=$DEFAULT_PRIVATE_DNS_HOSTNAME"
    fi

    for _hook in OUTPUT FORWARD; do
        diag_jump iptables ipv4 "$_hook"
        if ipv6_firewall_enabled; then
            diag_jump ip6tables ipv6 "$_hook"
        else
            diag ok "ip6tables $_hook skipped (IPv4-only firewall)" "ip6tables $_hook" "skipped (IPv4-only firewall)" jump_rule skipped_no_ipv6 subject=ip6tables table=ip6tables "hook=$_hook" family=ipv6
        fi
    done

    if has_cmd ip; then
        if ip route get 1.1.1.1 >/dev/null 2>&1; then
            diag ok "IPv4 route lookup works" "IPv4 routing" "route lookup works" routing ok family=ipv4
        else
            diag fail "IPv4 route lookup failed" "IPv4 routing" "route lookup failed" routing fail family=ipv4
        fi
        if ipv6_network_available; then
            diag ok "IPv6 route lookup works" "IPv6 routing" "route lookup works" routing ok family=ipv6
        else
            diag ok "IPv6 not available on this network" "IPv6 routing" "not available on this network" routing unavailable family=ipv6
        fi
    fi

    if [ "$DIAG_JSON" = "1" ]; then
        printf '{"checks":[%s],"summary":{"ok":%d,"fail":%d,"total":%d}}\n' \
            "$DIAG_CHECKS" "$DIAG_OK" "$DIAG_FAIL" $((DIAG_OK + DIAG_FAIL))
    fi
}

# --- Events ---
print_events_json() {
    [ -f "$EVENTLOG" ] || { echo '[]'; return; }
    tail -n "$1" "$EVENTLOG" 2>/dev/null | {
        _sep=""
        printf '['
        while read -r _date _clock _type _msg || [ -n "$_date$_clock$_type$_msg" ]; do
            [ -n "$_date$_clock$_type" ] || continue
            printf '%s{"time":"%s %s","type":"%s","message":"%s"}' \
                "$_sep" "$_date" "$_clock" "$_type" "$(json_escape "$_msg")"
            _sep=","
        done
        printf ']\n'
    }
}

# --- Entry point ---
ensure_runtime_layout

case "$1" in
    "start")
        is_running && die "[!] nfqws2 is already running. Use 'nzapret restart' instead."
        echo "[*] Starting nzapret..."
        start_service || die "[-] Failed to start nfqws2. Check 'nzapret log' for details."
        report_started started
        ;;

    "stop")
        echo "[*] Stopping nzapret..."
        if stop_service || ! has_jump_rules; then
            echo "[+] Stopped"
        else
            die "[-] Failed to stop cleanly. Check 'nzapret log' for details."
        fi
        ;;

    "restart")
        echo "[*] Restarting nzapret..."
        stop_service || die "[-] Failed to stop current nfqws2 instance cleanly."
        start_service || die "[-] Failed to restart nfqws2. Check 'nzapret log' for details."
        report_started restarted
        ;;

    "update")
        require_cmd curl
        case "$2" in
            ""|"all"|"list") ;;
            *) die "Usage: nzapret update [list]" ;;
        esac
        echo "[*] Updating list-general.txt..."
        if ! update_general_list; then
            log_event ERROR "list-general.txt update failed"
            exit 1
        fi
        log_event UPDATE "list-general.txt updated ($(general_list_count 1) domains)"
        refresh_hostlists_if_running
        ;;

    "status")
        if [ "$2" = "--json" ]; then
            print_status_json
        else
            print_status_human
        fi
        ;;

    "log")
        load_process_state
        if [ -n "$PID" ]; then
            echo "nfqws2 is running (PID: $PID)"
            [ "$PID_COUNT" -gt 1 ] && echo "warning: multiple nfqws2 processes detected ($PID_COUNT)"
            echo "Cmdline:"
            tr '\0' ' ' < "/proc/$PID/cmdline" 2>/dev/null
            echo ""
            echo ""
            echo "Open files: $(ls "/proc/$PID/fd" 2>/dev/null | wc -l)"
            echo "Memory: $(grep VmRSS "/proc/$PID/status" 2>/dev/null)"
        else
            echo "nfqws2 is not running"
        fi
        echo ""
        echo "Last 50 lines of logs:"
        if [ -f "$LOGFILE" ]; then
            tail -n 50 "$LOGFILE"
        else
            echo "Log file not found."
        fi
        ;;

    "profile")
        case "$2" in
            ""|"status")
                _pname=$(get_active_profile)
                echo "Configuration preset: $_pname ($(get_profile_label "$_pname"))"
                ;;
            "list")
                list_profiles
                ;;
            "set")
                [ -n "$3" ] || die "Usage: nzapret profile set <name>"
                set_active_profile "$3"
                log_event PROFILE "changed to $3 ($(get_profile_label "$3"))"
                echo "[+] Configuration preset set to: $3"
                echo "[*] Restart nzapret to apply changes"
                ;;
            *)
                die "Usage: nzapret profile [status|list|set <name>]"
                ;;
        esac
        ;;

    "network")
        case "$2" in
            ""|"status") ;;
            *) die "Usage: nzapret network [status]" ;;
        esac
        echo "Firewall stack: $(firewall_stack_label)"
        if ipv6_network_available; then
            echo "IPv6 network: available"
        else
            echo "IPv6 network: not available on current network"
        fi
        ;;

    "dns")
        case "$2" in
            ""|"status")
                print_private_dns_status
                ;;
            "set")
                case "$3" in
                    "off")
                        set_private_dns off || die "[-] Failed to disable Private DNS"
                        log_event DNS "Private DNS set to off"
                        echo "[+] Private DNS disabled"
                        ;;
                    "auto")
                        set_private_dns auto || die "[-] Failed to switch Private DNS to automatic mode"
                        log_event DNS "Private DNS set to automatic mode"
                        echo "[+] Private DNS set to Automatic"
                        ;;
                    "default"|"hostname")
                        if [ "$3" = "default" ]; then
                            _dns_host="$DEFAULT_PRIVATE_DNS_HOSTNAME"
                        else
                            [ -n "$4" ] || die "Usage: nzapret dns set hostname <fqdn>"
                            _dns_host=$(normalize_private_dns_hostname "$4")
                            is_valid_private_dns_hostname "$_dns_host" || die "[-] Invalid Private DNS hostname: $4"
                        fi
                        set_private_dns hostname "$_dns_host" || die "[-] Failed to apply Private DNS hostname"
                        log_event DNS "Private DNS provider set to $_dns_host"
                        echo "[+] Private DNS provider set to: $_dns_host"
                        ;;
                    *)
                        dns_usage
                        ;;
                esac
                ;;
            *)
                dns_usage
                ;;
        esac
        ;;

    "list-user")
        _cmd="$2"
        case "$_cmd" in
            "add"|"remove"|"replace")
                shift 2
                [ "$#" -gt 0 ] || die "Usage: nzapret list-user $_cmd <domain> [domain...]"
                ;;
        esac
        case "$_cmd" in
            ""|"status")
                print_user_list_status
                ;;
            "show")
                if [ -f "$USER_LIST_FILE" ]; then
                    cat "$USER_LIST_FILE"
                fi
                ;;
            "add")
                _added=$(update_user_list append "$@") || die "[-] Failed to update list-user.txt"
                if [ "$_added" -eq 0 ]; then
                    echo "[*] list-user.txt already contains those domains"
                    exit 0
                fi
                _user_count=$(domain_count "$USER_LIST_FILE")
                log_event USERLIST "added $_added domains ($_user_count total)"
                echo "[+] Added $_added domains to list-user.txt ($_user_count total)"
                refresh_hostlists_if_running
                ;;
            "remove")
                _before=$(domain_count "$USER_LIST_FILE")
                remove_user_list_entries "$@" || die "[-] Failed to update list-user.txt"
                _after=$(domain_count "$USER_LIST_FILE")
                _removed=$((_before - _after))
                if [ "$_removed" -le 0 ]; then
                    echo "[*] No matching domains found in list-user.txt"
                    exit 0
                fi
                log_event USERLIST "removed $_removed domains ($_after total)"
                echo "[+] Removed $_removed domains from list-user.txt ($_after total)"
                refresh_hostlists_if_running
                ;;
            "replace")
                update_user_list replace "$@" >/dev/null || die "[-] Failed to rewrite list-user.txt"
                _user_count=$(domain_count "$USER_LIST_FILE")
                log_event USERLIST "replaced list-user.txt ($_user_count total)"
                echo "[+] Saved list-user.txt ($_user_count domains)"
                refresh_hostlists_if_running
                ;;
            "clear")
                _before=$(domain_count "$USER_LIST_FILE")
                : > "$USER_LIST_FILE" || die "[-] Failed to clear list-user.txt"
                if [ "$_before" -gt 0 ]; then
                    echo "[+] list-user.txt cleared"
                    log_event USERLIST "cleared list-user.txt"
                    refresh_hostlists_if_running
                else
                    echo "[*] list-user.txt is already empty"
                fi
                ;;
            *)
                die "Usage: nzapret list-user [status|show|add <domain...>|remove <domain...>|replace <domain...>|clear]"
                ;;
        esac
        ;;

    "diagnose")
        if [ "$2" = "--json" ]; then
            run_diagnose 1
        else
            run_diagnose
        fi
        ;;

    "events")
        _evt_tail=30
        _evt_json=0
        _evt_clear=0
        shift
        for _arg in "$@"; do
            case "$_arg" in
                "clear"|"--clear") _evt_clear=1 ;;
                "--json") _evt_json=1 ;;
                --tail=*) _evt_tail="${_arg#--tail=}" ;;
            esac
        done
        if [ "$_evt_clear" = "1" ]; then
            : > "$EVENTLOG" || die "[-] Failed to clear event log."
            echo "[+] Event log cleared."
        elif [ "$_evt_json" = "1" ]; then
            print_events_json "$_evt_tail"
        elif [ -f "$EVENTLOG" ]; then
            tail -n "$_evt_tail" "$EVENTLOG"
        else
            echo "No events recorded yet."
        fi
        ;;

    "tg")
        case "$2" in
            ""|"status")
                if [ "$3" = "--json" ]; then
                    print_tg_status_json
                else
                    print_tg_status
                fi
                ;;
            "link")
                get_tg_link || die "[-] Failed to build link"
                echo ""
                ;;
            "open")
                _tglink=$(get_tg_link) || die "[-] Failed to build link"
                am start -a android.intent.action.VIEW -d "$_tglink" >/dev/null 2>&1 \
                    || die "[-] Failed to launch Telegram"
                echo "[+] Opening Telegram..."
                ;;
            "regen-secret")
                [ -f "$NZTG_BIN" ] || die "[-] nztg binary missing"
                _newsec=$(write_tg_secret) || die "[-] Failed to generate secret"
                log_event TGPROXY "secret regenerated"
                echo "[+] New secret: $_newsec"
                echo "[*] Restart nzapret to apply changes"
                ;;
            "cf-test")
                [ -f "$NZTG_BIN" ] || die "[-] nztg binary missing"
                _json_flag="$3"
                _cfd=$(get_tg_conf cf_domain "")
                set -- cftest
                [ "$_json_flag" = "--json" ] && set -- "$@" --json
                [ -n "$_cfd" ] && set -- "$@" --domain "$_cfd"
                "$NZTG_BIN" "$@"
                ;;
            "set")
                _what="$3"
                _val="$4"
                case "$_what" in
                    "host")
                        case "$_val" in
                            ""|*[[:space:]]*) die "Usage: nzapret tg set host <ip>" ;;
                        esac
                        set -- host "$_val"
                        ;;
                    "port")
                        case "$_val" in
                            ''|*[!0-9]*) die "[-] Port must be numeric" ;;
                        esac
                        set -- port "$_val"
                        ;;
                    "cf")
                        _sw=$(parse_switch "$_val") || die "Usage: nzapret tg set cf <on|off>"
                        set -- cf_enabled "$_sw"
                        ;;
                    "cf-domain")
                        set -- cf_domain "$_val"
                        ;;
                    "preresolve")
                        _sw=$(parse_switch "$_val") || die "Usage: nzapret tg set preresolve <on|off>"
                        set -- preresolve_enabled "$_sw"
                        ;;
                    "dc")
                        _rules=$(printf '%s\n' "$_val" | validate_tg_dc_rules) \
                            || die "[-] Invalid DC rules (expected 'number:IP' per line)"
                        _old_ifs=$IFS
                        IFS='
'
                        set -- dc $_rules
                        IFS=$_old_ifs
                        ;;
                    *)
                        die "Usage: nzapret tg set <host|port|cf|cf-domain|preresolve|dc> <value>"
                        ;;
                esac
                tg_conf_set "$@" || die "[-] Failed to save"
                log_event TGPROXY "config updated ($_what)"
                echo "[+] Saved"
                echo "[*] Restart nzapret to apply changes"
                ;;
            *)
                die "Usage: nzapret tg [status [--json]|set <key> <value>|link|open|regen-secret|cf-test [--json]]"
                ;;
        esac
        ;;

    *)
        echo "nzapret Management Utility (Magisk)"
        echo "Usage: nzapret <command> [options]"
        echo ""
        echo "Commands:"
        echo "  start                       - start traffic interception"
        echo "  stop                        - stop interception and clear rules"
        echo "  restart                     - restart nfqws2 and iptables rules"
        echo "  update [list]               - update routing hostlist"
        echo "  status                      - show nfqws2, iptables and list info"
        echo "  status --json               - machine-readable status for WebUI"
        echo "  log                         - show nfqws2 runtime log"
        echo "  events                      - show event history"
        echo "  events clear                - clear the whole event log file"
        echo "  events --json [--tail=N]    - event history as JSON"
        echo "  profile <subcommand>        - show, list or switch nfqws2 profiles"
        echo "  network status              - show the active IPv4/IPv6 firewall stack"
        echo "  dns <subcommand>            - manage Android Private DNS"
        echo "  list-user <subcommand>      - manage the personal domain hostlist"
        echo "  tg <subcommand>             - manage the Telegram MTProto proxy"
        echo "  diagnose                    - run Android-side diagnostics"
        echo "  diagnose --json             - diagnostics as JSON for WebUI"
        echo "  help                        - show this help message"
        echo ""
        echo "Profile commands: status, list, set <name>"
        echo "DNS commands: status, set <off|auto|default>, set hostname <fqdn>"
        echo "User list commands: status, show, add, remove, replace, clear"
        echo "Telegram commands: status [--json], set <host|port|cf|cf-domain|preresolve|dc>, link, open, regen-secret, cf-test [--json]"
        ;;
esac
